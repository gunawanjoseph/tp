<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.layout.Region?>

<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="Address App" minWidth="450" minHeight="600" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
      </stylesheets>

      <VBox>
        <!-- Header with Logo and EduLink Text -->
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="10" VBox.vgrow="NEVER" prefHeight="90">
          <SVGPath content="M12 3L1 9l11 6 9-4.91V17h2V9L12 3zm0 2.18L19.17 9 12 12.82 4.83 9 12 5.18zM12 16l-6-3.27V17c0 1.66 2.69 3 6 3s6-1.34 6-3v-4.27L12 16z"
                   fill="white" scaleX="1.5" scaleY="1.5" styleClass="logo-icon"/>
          <Label text="EduLink" styleClass="app-title"/>
          <Region HBox.hgrow="ALWAYS"/>
          <VBox alignment="CENTER_RIGHT" spacing="6">
            <padding>
              <Insets top="0" right="5" bottom="0" left="5"/>
            </padding>
            <HBox spacing="60" alignment="CENTER_RIGHT">
              <Label fx:id="fileLabel" text="File" onMouseClicked="#handleExit" styleClass="file-label"/>
              <Label fx:id="helpLabel" text="Help" onMouseClicked="#handleHelp" styleClass="help-label"/>
            </HBox>
          </VBox>
        </HBox>

        <StackPane VBox.vgrow="NEVER" fx:id="commandBoxPlaceholder" styleClass="command-box-container" minHeight="70"/>

        <!-- Main Content Area with Sidebar -->
        <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
          <!-- Left Sidebar: Person List -->
          <VBox styleClass="sidebar-panel" minWidth="300" prefWidth="400">
            <StackPane fx:id="listPanelPlaceholder" VBox.vgrow="ALWAYS">
              <padding>
                <Insets top="10" right="5" bottom="10" left="10" />
              </padding>
            </StackPane>
          </VBox>

          <!-- Right Content Area: Result Display and Details -->
          <VBox styleClass="content-panel" VBox.vgrow="ALWAYS">
            <StackPane fx:id="resultDisplayPlaceholder" styleClass="result-display-area"
                       minHeight="100" prefHeight="300" VBox.vgrow="SOMETIMES">
              <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
              </padding>
            </StackPane>

            <!-- Additional content area for details/lessons -->
            <StackPane fx:id="detailsPlaceholder" VBox.vgrow="ALWAYS" styleClass="details-area">
              <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
              </padding>
            </StackPane>
          </VBox>
        </SplitPane>

        <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
      </VBox>
    </Scene>
  </scene>
</fx:root>